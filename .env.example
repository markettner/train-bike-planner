# Copy to .env.local and fill in. .env.local is gitignored.

# CARTO basemap API key, used for the dark-mode raster tiles.
# Get one (free, no approval) at https://carto.com/basemaps/apikey/
# Without it the dark basemap still renders, but every tile carries an
# "API KEY REQUIRED" watermark.
VITE_CARTO_API_KEY=
